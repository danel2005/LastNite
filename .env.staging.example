NODE_ENV=production
APP_ROLE=api
RUN_BACKGROUND_JOBS=false

DATABASE_URL=postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
REDIS_URL=rediss://default:password@your-upstash-host:6379

SUPABASE_URL=https://your-staging-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key
SUPABASE_JWT_SECRET=your-staging-jwt-secret
STORAGE_BUCKET_MEDIA=event-media

EXPO_PUBLIC_API_URL=https://lastnite-api-staging.example.com
