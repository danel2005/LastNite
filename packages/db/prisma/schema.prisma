// LastNite — Full Database Schema
// ORM: Prisma | DB: PostgreSQL (Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum EventState {
  draft
  scheduled
  live
  ending
  processing // recap being generated
  completed
  archived
  cancelled
}

enum EventTemplate {
  house_party
  night_out
  birthday
  bachelor_bachelorette
  trip
  festival
  trek
  ski
  wedding
  costume_party
}

enum MissionCategory {
  selfie
  group_selfie
  duo
  target_person
  object_hunt
  environment
  food_drink
  mood_vibe
  chaos
  public_social
  finale
  everyone_now
  custom
}

enum MissionMediaType {
  photo
  video
  any
}

enum MissionAssignmentStatus {
  pending  // created but not yet shown to user (e.g. future scheduled)
  active   // currently shown and awaiting submission
  completed
  expired
  skipped
}

enum SubmissionAssetType {
  photo
  video
}

enum SubmissionAssetStatus {
  pending_upload
  uploaded
  failed
}

enum ModerationStatus {
  pending
  approved
  flagged
  removed
}

enum ExportJobType {
  photo_pack
  highlight_reel
}

enum ExportJobStatus {
  pending
  processing
  ready
  failed
}

enum NotificationType {
  event_starting_soon
  event_started
  mission_assigned
  mission_expiring_soon
  group_mission_live
  event_ending_soon
  reveal_ready
  export_ready
}

enum ReportCategory {
  inappropriate
  harmful
  spam
  other
}

enum ReportStatus {
  pending
  reviewed
  resolved
  dismissed
}

// ─────────────────────────────────────────────────────────────────────────────
// USER & PROFILE
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  // Supabase Auth manages the actual auth — this id matches auth.users.id
  phone     String?  @unique
  email     String?  @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  profile               Profile?
  missionPreference     UserMissionPreference?
  hostedEvents          Event[]               @relation("EventHost")
  participations        Participant[]
  createdInvites        Invite[]
  missionAssignments    MissionAssignment[]
  submissions           Submission[]
  reactions             Reaction[]
  notifications         Notification[]
  exportJobs            ExportJob[]
  moderationReports     ModerationReport[]    @relation("ReportedBy")
  createdMissions       MissionDefinition[]   @relation("MissionCreator")
  targetedMissions      MissionDefinition[]   @relation("MissionTarget")

  @@map("users")
}

model Profile {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  displayName      String   @map("display_name") @db.VarChar(50)
  avatarStorageKey String?  @map("avatar_storage_key")
  expoPushToken    String?  @map("expo_push_token")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model UserMissionPreference {
  id                    String   @id @default(uuid())
  userId                String   @unique @map("user_id")
  disablePublicSocial   Boolean  @default(false) @map("disable_public_social")
  disableAlcoholRefs    Boolean  @default(false) @map("disable_alcohol_refs")
  // If set, skip missions with intensity > this value (1-5)
  disableIntensityAbove Int?     @map("disable_intensity_above")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_mission_preferences")
}

// ─────────────────────────────────────────────────────────────────────────────
// EVENT
// ─────────────────────────────────────────────────────────────────────────────

model Event {
  id                         String        @id @default(uuid())
  title                      String        @db.VarChar(100)
  hostId                     String        @map("host_id")
  state                      EventState    @default(draft)
  template                   EventTemplate @default(house_party)
  startsAt                   DateTime      @map("starts_at") @db.Timestamptz()
  endsAt                     DateTime      @map("ends_at") @db.Timestamptz()
  // How often missions are dispatched (minutes)
  missionIntervalMinutes     Int           @default(30) @map("mission_interval_minutes")
  // 1 (chill) to 5 (chaos) — affects which missions are selected
  missionIntensity           Int           @default(3) @map("mission_intensity")
  allowCustomMissions        Boolean       @default(true) @map("allow_custom_missions")
  allowPublicSocialMissions  Boolean       @default(false) @map("allow_public_social_missions")
  safeMode                   Boolean       @default(false) @map("safe_mode")
  inviteCode                 String        @unique @map("invite_code") @db.VarChar(10)
  deletedAt                  DateTime?     @map("deleted_at")
  createdAt                  DateTime      @default(now()) @map("created_at")
  updatedAt                  DateTime      @updatedAt @map("updated_at")

  // Relations
  host             User                @relation("EventHost", fields: [hostId], references: [id])
  participants     Participant[]
  invites          Invite[]
  missionInstances MissionInstance[]
  assignments      MissionAssignment[]
  submissions      Submission[]
  activePacks      EventMissionPack[]
  customMissions   MissionDefinition[] @relation("EventCustomMissions")
  notifications    Notification[]
  recapArtifact    RecapArtifact?
  exportJobs       ExportJob[]

  // Indexes
  @@index([state, startsAt])       // scheduler: find events that should go live
  @@index([state, endsAt])         // scheduler: find events that should close
  @@index([hostId])
  @@index([inviteCode])
  @@map("events")
}

model Participant {
  id           String    @id @default(uuid())
  eventId      String    @map("event_id")
  userId       String    @map("user_id")
  isHost       Boolean   @default(false) @map("is_host")
  joinedAt     DateTime  @default(now()) @map("joined_at")
  lastActiveAt DateTime? @map("last_active_at")
  removedAt    DateTime? @map("removed_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
  @@index([userId])           // "my events" query
  @@index([eventId])
  @@map("participants")
}

model Invite {
  id              String    @id @default(uuid())
  eventId         String    @map("event_id")
  code            String    @unique @db.VarChar(10)
  createdByUserId String    @map("created_by_user_id")
  usedCount       Int       @default(0) @map("used_count")
  expiresAt       DateTime? @map("expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy User  @relation(fields: [createdByUserId], references: [id])

  @@index([code])
  @@map("invites")
}

// ─────────────────────────────────────────────────────────────────────────────
// MISSION SYSTEM
// ─────────────────────────────────────────────────────────────────────────────

model MissionDefinition {
  id             String          @id @default(uuid())
  title          String          @db.VarChar(200)
  description    String          @db.Text
  category       MissionCategory
  mediaType      MissionMediaType @default(any) @map("media_type")
  intensity      Int             // 1–5
  isSocial       Boolean         @default(false) @map("is_social") // involves strangers
  // Default secret status — can be overridden per-assignment
  defaultIsSecret Boolean        @default(false) @map("default_is_secret")
  // For video missions: min and max clip duration
  minDurationMs  Int?            @map("min_duration_ms")
  maxDurationMs  Int?            @map("max_duration_ms")
  // System vs user-created
  isSystem       Boolean         @default(true) @map("is_system")
  // Set for user-created missions
  createdByUserId String?        @map("created_by_user_id")
  // Set for custom missions scoped to one event
  eventId        String?         @map("event_id")
  // For "photograph this specific person" missions
  targetUserId   String?         @map("target_user_id")
  deletedAt      DateTime?       @map("deleted_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  // Relations
  createdBy  User?                  @relation("MissionCreator", fields: [createdByUserId], references: [id])
  targetUser User?                  @relation("MissionTarget", fields: [targetUserId], references: [id])
  event      Event?                 @relation("EventCustomMissions", fields: [eventId], references: [id])
  packs      MissionPackDefinition[]
  instances  MissionInstance[]

  @@index([isSystem, category])
  @@index([eventId])             // custom missions for an event
  @@index([createdByUserId])
  @@map("mission_definitions")
}

model MissionPack {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(100)
  description String   @db.Text
  // e.g. "party", "birthday", "chaos", "safe", "bachelor"
  slug        String   @unique @db.VarChar(50)
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  definitions MissionPackDefinition[]
  events      EventMissionPack[]

  @@map("mission_packs")
}

// Join table: MissionPack ↔ MissionDefinition
model MissionPackDefinition {
  id           String @id @default(uuid())
  packId       String @map("pack_id")
  definitionId String @map("definition_id")

  pack       MissionPack       @relation(fields: [packId], references: [id], onDelete: Cascade)
  definition MissionDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([packId, definitionId])
  @@map("mission_pack_definitions")
}

// Which packs are active for a given event
model EventMissionPack {
  id      String @id @default(uuid())
  eventId String @map("event_id")
  packId  String @map("pack_id")

  event Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  pack  MissionPack @relation(fields: [packId], references: [id])

  @@unique([eventId, packId])
  @@map("event_mission_packs")
}

// A MissionDefinition instantiated for a specific event.
// One instance per definition per event.
// An instance can be assigned to multiple users (cycling).
model MissionInstance {
  id           String   @id @default(uuid())
  eventId      String   @map("event_id")
  definitionId String   @map("definition_id")
  // Finale missions are assigned to ALL participants simultaneously near event end
  isFinale     Boolean  @default(false) @map("is_finale")
  createdAt    DateTime @default(now()) @map("created_at")

  event      Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  definition MissionDefinition @relation(fields: [definitionId], references: [id])
  assignments MissionAssignment[]

  // One instance per definition per event
  @@unique([eventId, definitionId])
  @@index([eventId])
  @@map("mission_instances")
}

// A specific user receiving a specific mission instance at a specific time.
//
// CRITICAL PRIVACY INVARIANT:
// During a live event, this table's data is ONLY returned to the user
// whose userId matches. Never expose other users' assignments until
// event.state = 'completed'. The reveal is the payoff.
//
// CYCLING: The same MissionInstance can have multiple MissionAssignment rows
// (different userId, different assignedAt). This is intentional — it's how
// the same mission gets assigned to different people at different times,
// enabling comparison at the reveal.
model MissionAssignment {
  id                String                  @id @default(uuid())
  missionInstanceId String                  @map("mission_instance_id")
  // Denormalized for efficient "fetch my missions for this event" queries
  eventId           String                  @map("event_id")
  userId            String                  @map("user_id")
  // Overrides definition.defaultIsSecret — set at assignment time
  isSecret          Boolean                 @default(false) @map("is_secret")
  status            MissionAssignmentStatus @default(active)
  assignedAt        DateTime                @default(now()) @map("assigned_at")
  expiresAt         DateTime                @map("expires_at")
  completedAt       DateTime?               @map("completed_at")
  skippedAt         DateTime?               @map("skipped_at")

  missionInstance MissionInstance @relation(fields: [missionInstanceId], references: [id])
  event           Event           @relation(fields: [eventId], references: [id])
  user            User            @relation(fields: [userId], references: [id])
  submission      Submission?

  // A user cannot get the same mission instance twice in the same event
  @@unique([userId, missionInstanceId])
  // Primary query pattern: "give me active missions for userId in eventId"
  @@index([eventId, userId, status])
  @@index([status, expiresAt])   // expiry worker: find assignments that just expired
  @@index([eventId])             // reveal: fetch all assignments for an event
  @@map("mission_assignments")
}

// ─────────────────────────────────────────────────────────────────────────────
// SUBMISSIONS & MEDIA
// ─────────────────────────────────────────────────────────────────────────────

model Submission {
  id           String   @id @default(uuid())
  eventId      String   @map("event_id")
  userId       String   @map("user_id")
  assignmentId String   @unique @map("assignment_id") // 1:1 with MissionAssignment
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  event      Event             @relation(fields: [eventId], references: [id])
  user       User              @relation(fields: [userId], references: [id])
  assignment MissionAssignment @relation(fields: [assignmentId], references: [id])
  assets     SubmissionAsset[]
  reactions  Reaction[]

  @@index([eventId, createdAt])  // feed: ordered by time
  @@index([userId, eventId])
  @@map("submissions")
}

model SubmissionAsset {
  id               String               @id @default(uuid())
  submissionId     String               @map("submission_id")
  assetType        SubmissionAssetType  @map("asset_type")
  status           SubmissionAssetStatus @default(pending_upload)
  // Path in Supabase Storage (e.g. "events/{eventId}/{userId}/{uuid}.jpg")
  storageKey       String               @map("storage_key")
  mimeType         String               @map("mime_type") @db.VarChar(50)
  // Set after upload confirmation
  fileSizeBytes    BigInt?              @map("file_size_bytes")
  widthPx          Int?                 @map("width_px")
  heightPx         Int?                 @map("height_px")
  durationMs       Int?                 @map("duration_ms") // video only
  capturedAt       DateTime?            @map("captured_at") @db.Timestamptz()
  moderationStatus ModerationStatus     @default(pending) @map("moderation_status")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  submission       Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  moderationReports ModerationReport[]

  @@index([submissionId])
  @@index([moderationStatus])   // moderation queue
  @@map("submission_assets")
}

model Reaction {
  id           String   @id @default(uuid())
  submissionId String   @map("submission_id")
  userId       String   @map("user_id")
  // One of: fire=🔥 heart=❤️ laugh=😂 wow=😮 — stored as text key
  emoji        String   @db.VarChar(10)
  createdAt    DateTime @default(now()) @map("created_at")

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id])

  // One reaction per user per submission
  @@unique([submissionId, userId])
  @@index([submissionId])
  @@map("reactions")
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  eventId   String?          @map("event_id")
  type      NotificationType
  // Flexible payload for push notification body + data
  payload   Json
  sentAt    DateTime?        @map("sent_at")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id])
  event Event? @relation(fields: [eventId], references: [id])

  @@index([userId, sentAt])   // delivery worker
  @@index([eventId, type])    // idempotency check
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// RECAP & EXPORT
// ─────────────────────────────────────────────────────────────────────────────

model RecapArtifact {
  id          String   @id @default(uuid())
  eventId     String   @unique @map("event_id")
  // Full structured recap: timeline, missionEntries, participantJourneys,
  // awards, stats, highlightReelAssetIds, collageAssetIds
  payload     Json
  generatedAt DateTime @map("generated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id])

  @@map("recap_artifacts")
}

model ExportJob {
  id                  String          @id @default(uuid())
  eventId             String          @map("event_id")
  requestedByUserId   String          @map("requested_by_user_id")
  type                ExportJobType
  status              ExportJobStatus @default(pending)
  // For photo_pack: signed URLs. For highlight_reel: ordered asset metadata.
  resultPayload       Json?           @map("result_payload")
  errorMessage        String?         @map("error_message") @db.Text
  createdAt           DateTime        @default(now()) @map("created_at")
  completedAt         DateTime?       @map("completed_at")

  event           Event @relation(fields: [eventId], references: [id])
  requestedByUser User  @relation(fields: [requestedByUserId], references: [id])

  @@index([eventId])
  @@index([status, createdAt])  // worker poll: find pending jobs
  @@map("export_jobs")
}

// ─────────────────────────────────────────────────────────────────────────────
// MODERATION
// ─────────────────────────────────────────────────────────────────────────────

model ModerationReport {
  id                String         @id @default(uuid())
  reportedByUserId  String         @map("reported_by_user_id")
  submissionAssetId String?        @map("submission_asset_id")
  category          ReportCategory
  description       String?        @db.Text
  status            ReportStatus   @default(pending)
  reviewedAt        DateTime?      @map("reviewed_at")
  createdAt         DateTime       @default(now()) @map("created_at")

  reportedBy      User             @relation("ReportedBy", fields: [reportedByUserId], references: [id])
  submissionAsset SubmissionAsset? @relation(fields: [submissionAssetId], references: [id])

  @@index([status, createdAt])  // moderation queue
  @@map("moderation_reports")
}
