NODE_ENV=development
APP_ROLE=api
RUN_BACKGROUND_JOBS=true
PORT=3001
HOST=0.0.0.0

# Local Docker default:
DATABASE_URL=postgresql://lastnite:lastnite@localhost:5432/lastnite_dev
#
# Supabase staging/prod usually works best through the Session Pooler:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase project credentials
# Found at: https://app.supabase.com/project/<project>/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Redis (for BullMQ job queue — needed from step 05 onwards)
REDIS_URL=redis://localhost:6379

# Supabase Storage bucket names (created in Supabase dashboard)
STORAGE_BUCKET_MEDIA=event-media
