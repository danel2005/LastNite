NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# PostgreSQL via Supabase (Direct Connection)
# Format: postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Supabase project credentials
# Found at: https://app.supabase.com/project/<project>/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Redis (for BullMQ job queue — needed from step 05 onwards)
REDIS_URL=redis://localhost:6379

# Supabase Storage bucket names (created in Supabase dashboard)
STORAGE_BUCKET_MEDIA=event-media
