{
  "name": "@lastnite/api",
  "version": "0.0.1",
  "private": true,
  "description": "LastNite backend API — Fastify + TypeScript",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@lastnite/db": "*",
    "@lastnite/shared": "*",
    "@supabase/supabase-js": "^2.101.1",
    "bullmq": "^5.72.1",
    "dotenv": "^17.4.0",
    "fastify": "^4.28.1",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.10.1",
    "pino-pretty": "^13.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@lastnite/config": "*",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
