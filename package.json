{
  "name": "lastnite",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "npm run dev:all",
    "dev:api": "npm run dev -w @lastnite/api",
    "dev:worker": "npm run dev:worker -w @lastnite/api",
    "dev:mobile": "npm run dev -w @lastnite/mobile -- --lan",
    "dev:phone": "bash scripts/dev-phone.sh",
    "dev:tunnel": "bash scripts/dev-tunnel.sh",
    "dev:all": "concurrently -n api,mobile -c blue,magenta \"npm:dev:api\" \"npm:dev:mobile\"",
    "mobile": "npm run dev:mobile",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:api": "npm run test -w @lastnite/api",
    "smoke": "tsx scripts/smoke-test.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:seed": "turbo db:seed"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.3.3",
    "tsx": "^4.21.0",
    "turbo": "^2.3.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.19"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100,
    "tabWidth": 2
  },
  "dependencies": {
    "react-native-web": "~0.19.10"
  }
}
